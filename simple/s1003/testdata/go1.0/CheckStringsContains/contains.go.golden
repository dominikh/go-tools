package pkg

import (
	"bytes"
	stringspkg "strings"
)

type indexer struct{}

func (indexer) Index(string, string) int { return 0 }

func fn() {
	_ = stringspkg.ContainsRune("", 'x') //@ diag(` stringspkg.ContainsRune`)
	_ = stringspkg.ContainsRune("", 'x') //@ diag(` stringspkg.ContainsRune`)
	_ = stringspkg.IndexRune("", 'x') > 0
	_ = stringspkg.IndexRune("", 'x') >= -1
	_ = stringspkg.ContainsRune("", 'x')  //@ diag(` stringspkg.ContainsRune`)
	_ = !stringspkg.ContainsRune("", 'x') //@ diag(`!stringspkg.ContainsRune`)
	_ = stringspkg.IndexRune("", 'x') != 0
	_ = !stringspkg.ContainsRune("", 'x') //@ diag(`!stringspkg.ContainsRune`)

	_ = stringspkg.ContainsAny("", "") //@ diag(` stringspkg.ContainsAny`)
	_ = stringspkg.ContainsAny("", "") //@ diag(` stringspkg.ContainsAny`)
	_ = stringspkg.IndexAny("", "") > 0
	_ = stringspkg.IndexAny("", "") >= -1
	_ = stringspkg.ContainsAny("", "")  //@ diag(` stringspkg.ContainsAny`)
	_ = !stringspkg.ContainsAny("", "") //@ diag(`!stringspkg.ContainsAny`)
	_ = stringspkg.IndexAny("", "") != 0
	_ = !stringspkg.ContainsAny("", "") //@ diag(`!stringspkg.ContainsAny`)

	_ = stringspkg.Contains("", "") //@ diag(` stringspkg.Contains`)
	_ = stringspkg.Contains("", "") //@ diag(` stringspkg.Contains`)
	_ = stringspkg.Index("", "") > 0
	_ = stringspkg.Index("", "") >= -1
	_ = stringspkg.Contains("", "")  //@ diag(` stringspkg.Contains`)
	_ = !stringspkg.Contains("", "") //@ diag(`!stringspkg.Contains`)
	_ = stringspkg.Index("", "") != 0
	_ = !stringspkg.Contains("", "") //@ diag(`!stringspkg.Contains`)

	_ = bytes.ContainsRune(nil, 'x') //@ diag(` bytes.ContainsRune`)
	_ = bytes.ContainsAny(nil, "")   //@ diag(` bytes.ContainsAny`)
	_ = bytes.Contains(nil, nil)     //@ diag(` bytes.Contains`)

	strings := indexer{}
	bytes := indexer{}
	_ = strings.Index("", "") > -1
	_ = bytes.Index("", "") > -1
}
