-- Use context.Background --
package pkg

import "context"

func fn1(ctx context.Context)           {}
func fn2(x string, ctx context.Context) {}
func fn4()                              {}

type T struct{}

func (*T) Foo()                    {}
func (*T) Bar(ctx context.Context) {}

type I interface {
	Bar(ctx context.Context)
}

func fn3() {
	fn1(context.Background()) //@ diag(`do not pass a nil Context`)
	fn1(context.TODO())
	fn2("", nil)
	fn4()

	// don't flag this conversion
	_ = (func(context.Context))(nil)
	// and don't crash on these
	_ = (func())(nil)
	(*T).Foo(nil)

	var t *T
	t.Bar(context.Background()) //@ diag(`do not pass a nil Context`)
	(*T).Bar(nil, context.Background())
	((*T).Bar)(nil, context.Background())
	I.Bar(nil, context.Background())
	(context.Context).Value(nil, "k")
	(*T).Bar(t, context.Background())   //@ diag(`do not pass a nil Context`)
	(*T).Bar(nil, context.Background()) //@ diag(`do not pass a nil Context`)
}
